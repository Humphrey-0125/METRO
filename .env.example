# ============================================================
# LLM Backend for Chat
# Choose: compatible | openai
# ============================================================
LLM_BACKEND=compatible

# ---- Compatible (OpenAI-compatible relay, e.g. bltcy.ai) ----
COMPATIBLE_KEY=
COMPATIBLE_URL=https://api.bltcy.ai/v1/chat/completions
COMPATIBLE_MODEL=gpt-4o-mini

# ---- OpenAI Official ----
OPENAI_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Embedding API (SiliconFlow)
# Used for history-based retrieval, always required
# ============================================================
SILICONFLOW_KEY=
SILICONFLOW_EMBED_URL=https://api.siliconflow.cn/v1/embeddings
SILICONFLOW_EMBED_MODEL=BAAI/bge-large-en-v1.5
